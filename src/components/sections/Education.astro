34 -1.0312166666666667 0.00002916666666666667 -0.3727791666666667 0.14230416666666668 -0.7463458333333334 0.42711666666666664 -1.0311875 0.2848416666666667 -0.2848125 0.6584083333333334 -0.4270875 1.0312166666666667 -0.42711666666666664ZM9.041666666666668 7.356620833333333c-0.5637916666666667 0 -1.0208333333333335 0.4570416666666667 -1.0208333333333335 1.0208333333333335s0.4570416666666667 1.0208333333333335 1.0208333333333335 1.0208333333333335 1.0208333333333335 -0.4570416666666667 1.0208333333333335 -1.0208333333333335 -0.4570416666666667 -1.0208333333333335 -1.0208333333333335 -1.0208333333333335ZM2.999266666666667 3.5c0 -0.32217500000000004 0.2611583333333333 -0.5833333333333334 0.5833333333333334 -0.5833333333333334h5.979837500000001c0.32214583333333335 0 0.5833333333333334 0.2611583333333333 0.5833333333333334 0.5833333333333334s-0.2611875 0.5833333333333334 -0.5833333333333334 0.5833333333333334H3.5826000000000007c-0.32217500000000004 0 -0.5833333333333334 -0.2611583333333333 -0.5833333333333334 -0.5833333333333334Zm0.5833333333333334 1.3466833333333335c-0.32217500000000004 0 -0.5833333333333334 0.2611583333333333 -0.5833333333333334 0.5833333333333334s0.2611583333333333 0.5833333333333334 0.5833333333333334 0.5833333333333334h1.708525c0.32217500000000004 0 0.5833333333333334 -0.2611583333333333 0.5833333333333334 -0.5833333333333334s-0.2611583333333333 -0.5833333333333334 -0.5833333333333334 -0.5833333333333334h-1.708525Z"
                      clip-rule="evenodd"
                      stroke-width="0.2917"
                    />
                  </g>
                </svg>
                <div class="relative w-full items-baseline justify-between gap-2">
                  <h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 text-md">
                    <a
                      class="group flex items-center gap-[6px] text-skin-base decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline"
                      href={url}
                      target="_blank"
                    >
                      {name}
                    </a>
                  </h3>
                  <div class="text-sm text-skin-muted">{issuer}</div>
                  <time class="right-0 top-0 text-xs text-skin-muted md:absolute md:block">
                    {certificateYear}
                  </time>
                </div>
              </div>
            );
          })}
        </ul>
      </>
    )
  }
</Section>

<script>
  // Progressive enhancement: refresh the completed-ECTS figure from the cached
  // serverless endpoint so it stays live between deploys. Falls back silently to
  // the build-time value if the request fails. The secret Koski URL is never
  // touched here — only our own /api/credits.json proxy is called.
  (async () => {
    const targets = document.querySelectorAll<HTMLElement>("[data-live-ects]");
    if (targets.length === 0) return;

    try {
      const response = await fetch("/api/credits.json");
      if (!response.ok) return;

      const { completedEcts } = (await response.json()) as {
        completedEcts: number | null;
      };
      if (completedEcts === null || completedEcts === undefined) return;

      targets.forEach((el) => {
        const total = el.dataset.ectsTotal;
        if (!total) return;
        el.textContent = `, ${completedEcts}/${total} ECTS cr`;
      });
    } catch {
      // Keep the build-time value on any network/parse error.
    }
  })();
</script>
