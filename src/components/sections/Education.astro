---
import Section from "../Section.astro";

import { education } from "@cv";
import { certificates } from "@cv";
import { fetchCompletedEcts } from "@/lib/koski";

// Build-time fetch of completed ECTS so the value is present in the static HTML
// (works with no JavaScript, in print/PDF, and avoids layout shift). A client
// script later refreshes it from the cached /api/credits.json endpoint for
// liveness between deploys. If the fetch fails the build still succeeds and the
// client script fills the value in.
let completedEcts: number | null = null;
try {
  completedEcts = await fetchCompletedEcts();
} catch (error) {
  console.warn("[koski] Build-time ECTS fetch failed; relying on client refresh.", error);
}

const formatEcts = (completed: number, total: number) =>
  `, ${completed}/${total} ECTS cr`;
---

<Section className={Astro.props.className} title="Education">
  <ul class="space-y-4 py-3 print:space-y-0">
    {
      education.map(
        ({ institution, startDate, endDate, area, url, location, liveEcts }) => {
          const formatDate = (date: string | number | Date) => {
            if (!date) return "Present";
            const d = new Date(date);
            const monthNames = [
              "Jan.",
              "Feb.",
              "Mar.",
              "Apr.",
              "May.",
              "Jun.",
              "Jul.",
              "Aug.",
              "Sep.",
              "Oct.",
              "Nov.",
              "Dec.",
            ];
            const month = monthNames[d.getMonth()];
            const year = d.getFullYear();
            return `${month} ${year}`;
          };
          const startFormatted = formatDate(startDate);
          const endFormatted = endDate ? formatDate(endDate) : "Present";
          const years = `${startFormatted} - ${endFormatted}`;

          return (
            <div class="flex items-start">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-2 hidden h-5 w-5 self-start md:inline-block print:hidden"
              >
                <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
                <path d="M22 10v6" />
                <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
              </svg>

              <div class="relative w-full">
                <div class="flex items-baseline justify-between gap-2">
                  <h3 class="text-md">
                    <a
                      target="_blank"
                      href={url}
                      class="group flex items-center gap-[6px] decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline"
                    >
                      {institution}
                    </a>
                  </h3>
                  {location && (
                    <span class="whitespace-nowrap text-sm text-skin-muted">
                      {location}
                    </span>
                  )}
                </div>
                <div class="flex items-center justify-between text-sm text-skin-muted">
                  <div>
                    {area}{liveEcts && (
                      <span data-live-ects data-ects-total={liveEcts.total}>{completedEcts !== null ? formatEcts(completedEcts, liveEcts.total) : ""}</span>
                    )}
                  </div>
                  <time>{years}</time>
                </div>
              </div>
            </div>
          );
        }
      )
    }
  </ul>

  {
    certificates.length > 0 && (
      <>
        <h4 class="relative flex w-full items-center gap-3 pb-4 text-3xl print:gap-1 print:pb-0 print:text-xl">Certifications, Honors & Awards</h4>
        <ul class="space-y-4 py-3 print:space-y-0">
          {certificates.map(({ name, date, issuer, url }) => {
            const formatDate = (date: string | number | Date) => {
              if (!date) return "Present";
              const d = new Date(date);
              const monthNames = [
                "Jan.",
                "Feb.",
                "Mar.",
                "Apr.",
                "May.",
                "Jun.",
                "Jul.",
                "Aug.",
                "Sep.",
                "Oct.",
                "Nov.",
                "Dec.",
              ];
              const month = monthNames[d.getMonth()];
              const year = d.getFullYear();
              return `${month} ${year}`;
            };
            const certificateYear = formatDate(date);
            return (
              <div class="flex items-baseline">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 14 14"
                  id="Document-Certificate--Streamline-Plump-Remix"
                  height="14"
                  width="14"
                  class="mr-2 hidden h-5 w-5 self-start md:inline-block print:hidden"
                >
                  <desc>
                    Document Certificate Streamline Icon:
                    https://streamlinehq.com
                  </desc>
                  <g id="document-certificate--document-contract-license-permission-award">
                    <path
                      id="Union"
                      fill="currentColor"
                      fill-rule="evenodd"
                      d="M6.999533333333334 0.4375c-2.111054166666667 0 -3.5916708333333336 0.06584083333333333 -4.524788333333333 0.1287825 -0.9900216666666667 0.06678 -1.8060904166666667 0.7957570833333334 -1.8977029166666668 1.8042208333333336 -0.07150208333333334 0.7870800000000001 -0.14068250000000002 1.9718008333333334 -0.14068250000000002 3.6096258333333333 0 1.6378541666666668 0.06918041666666667 2.8225458333333338 0.14068250000000002 3.6096375000000003 0.09160958333333333 1.0084666666666666 0.9076812500000001 1.7374291666666668 1.8977000000000002 1.8042208333333336 0.6675579166666668 0.04503333333333334 1.61532875 0.09152500000000001 2.873607916666667 0.1143625 0.3221166666666667 0.005833333333333334 0.5879708333333333 -0.25054166666666666 0.5938333333333334 -0.5726583333333334 0.005833333333333334 -0.3221166666666667 -0.25054166666666666 -0.5879708333333333 -0.5726583333333334 -0.5938041666666667 -1.2402250000000001 -0.02251666666666667 -2.168804166666667 -0.06825 -2.8162662500000004 -0.1119125 -0.4619329166666667 -0.031179166666666668 -0.7785079166666666 -0.3513708333333334 -0.81433625 -0.7457625000000001 -0.06809833333333333 -0.7496416666666667 -0.13589625000000002 -1.8990125000000002 -0.13589625000000002 -3.5040833333333334 0 -1.6050416666666667 0.06780083333333334 -2.7544416666666667 0.13589916666666668 -3.5040745833333338 0.035825416666666665 -0.39438875 0.35240041666666666 -0.7145920833333333 0.81433625 -0.7457508333333334C3.4582916666666668 1.6692579166666666 4.912629166666667 1.6041666666666667 6.999533333333334 1.6041666666666667c2.086875 0 3.5412125 0.06509125 4.446254166666667 0.12614 0.46194166666666675 0.03115875 0.7785166666666667 0.3513591666666667 0.8143333333333334 0.7457508333333334 0.06810416666666667 0.74963 0.1358875 1.89903 0.1358875 3.5040716666666674 0 0.32217500000000004 0.2611875 0.5833333333333334 0.5833333333333334 0.5833333333333334 0.32217500000000004 0 0.5833333333333334 -0.2611583333333333 0.5833333333333334 -0.5833333333333