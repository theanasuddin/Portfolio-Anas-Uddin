---
import Theme from "@/icons/themeSwitch.astro";
---

<div class="no-print inline-flex items-center">
	<div
		x-data="themeDropdown"
		@keydown.escape.window="open = false"
		@click.outside="open = false"
		class="group/theme relative inline-flex"
	>
		<!-- Hidden native control kept in the DOM so the existing theme scripts keep working. -->
		<select id="themeSwitch" name="themeSwitch" tabindex="-1" aria-hidden="true" class="sr-only">
			<option value="system">System</option>
			<option value="dark">Dark</option>
			<option value="light">Light</option>
		</select>

		<button
			type="button"
			@click="open = !open"
			:aria-expanded="open"
			aria-haspopup="listbox"
			aria-label="Switch theme"
			class="flex items-center gap-2 rounded-md bg-skin-button-muted px-3 py-1.5 text-sm font-medium text-skin-base ring-1 ring-inset ring-skin-muted transition-colors duration-200 hover:ring-skin-hue focus:outline-none focus-visible:ring-2 focus-visible:ring-skin-hue"
		>
			<span class="inline-flex transition-transform duration-300 ease-in-out group-hover/theme:rotate-45 [&>svg]:size-4"><Theme /></span>
			<span class="min-w-[3.5rem] text-left" x-text="label">System</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-4 text-skin-muted transition-transform duration-200"
				:class="open ? '-rotate-180' : ''"
				><path d="m6 9 6 6 6-6"></path></svg
			>
		</button>

		<ul
			x-show="open"
			style="display: none;"
			role="listbox"
			x-transition:enter="transition ease-out duration-150"
			x-transition:enter-start="opacity-0 -translate-y-1"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition ease-in duration-100"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 -translate-y-1"
			class="absolute left-0 top-full z-30 mt-2 min-w-full overflow-hidden rounded-md bg-skin-fill p-1 shadow-lg ring-1 ring-skin-muted"
		>
			<template x-for="opt in options" :key="opt.value">
				<li
					role="option"
					:aria-selected="opt.value === value"
					@click="choose(opt.value)"
					class="flex cursor-pointer items-center justify-between gap-4 rounded px-3 py-1.5 text-sm text-skin-base transition-colors duration-150 hover:bg-skin-button-accent hover:text-skin-inverted"
					:class="opt.value === value ? 'font-medium text-skin-hue' : ''"
				>
					<span x-text="opt.label"></span>
					<svg
						x-show="opt.value === value"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-3.5"
						><path d="M20 6 9 17l-5-5"></path></svg
					>
				</li>
			</template>
		</ul>
	</div>

	<style>
		:global(.dark) {
			color-scheme: dark;
		}
	</style>

	<script>
		// Apply the saved/system theme on load and keep <html> + storage in sync.
		const select = document.getElementById("themeSwitch") as HTMLSelectElement;
		const storedTheme = localStorage.getItem("theme");
		const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

		select.value = storedTheme !== null ? storedTheme : systemTheme;

		function updateTheme(value: string) {
			const theme = value === "system" ? systemTheme : value;
			document.documentElement.classList.remove("light", "dark");
			document.documentElement.classList.add(theme);
			localStorage.setItem("theme", value);
		}

		updateTheme(select.value);

		select.addEventListener("change", (event: Event) => {
			const target = event.target as HTMLSelectElement;
			updateTheme(target.value);
		});

		// Register the custom dropdown as an Alpine component so the markup stays declarative.
		type ThemeOption = { value: string; label: string };
		document.addEventListener("alpine:init", () => {
			(window as any).Alpine.data("themeDropdown", () => ({
				open: false,
				value: select.value,
				options: [
					{ value: "system", label: "System" },
					{ value: "dark", label: "Dark" },
					{ value: "light", label: "Light" },
				] as ThemeOption[],
				get label(): string {
					const match = this.options.find((o: ThemeOption) => o.value === this.value);
					return match ? match.label : "System";
				},
				init() {
					this.value = storedTheme !== null ? storedTheme : systemTheme;
					select.addEventListener("change", () => {
						this.value = select.value;
					});
				},
				choose(value: string) {
					this.value = value;
					this.open = false;
					select.value = value;
					select.dispatchEvent(new Event("change"));
				},
			}));
		});
	</script>
</div>
