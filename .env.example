# Personal Koski (opintopolku.fi) study-record endpoint used to fetch completed
# ECTS credits. The real URL embeds a secret token — keep it only in .env locally
# and in Vercel Environment Variables in production. Never commit the real value.
KOSKI_OPINNOT_URL="https://opintopolku.fi/koski/api/opinnot/<your-secret-token>"
